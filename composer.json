{
  "name": "lande_admin/badoucms",
  "description": "Build your admin framework",
  "type": "project",
  "keywords": [
    "badoucms",
    "thinkphp"
  ],
  "homepage": "http://www.badoucms.com",
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "lande",
      "email": "939134342@qq.com"
    }
  ],
  "require": {
    "php": ">=8.0.2",
    "topthink/framework": "8.1.4",
    "topthink/think-orm": "4.0.51",
    "topthink/think-multi-app": "1.1.1",
    "topthink/think-throttle": "2.0.2",
    "topthink/think-migration": "3.1.1",
    "symfony/http-foundation": "^5.4.50",
    "phpmailer/phpmailer": "^6.8",
    "guzzlehttp/guzzle": "^7.8.1",
    "nelexa/zip": "^4.0.0",
    "ext-bcmath": "*",
    "ext-iconv": "*",
    "ext-json": "*",
    "ext-gd": "*",
    "topthink/think-view": "^2.0",
    "topthink/think-captcha": "^3.0",
    "phpoffice/phpspreadsheet": "^2.1.17",
    "overtrue/pinyin": "^5.0",
    "ezyang/htmlpurifier": "^4.18",
    "symfony/var-exporter": "^5.4|^6.0"
  },
  "require-dev": {
    "symfony/var-dumper": "^5.4",
    "topthink/think-trace": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "app\\": "app",
      "modules\\": "modules"
    },
    "psr-0": {
      "": "extend/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "platform": {
      "php": "8.0.30"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php think service:discover",
      "@php think vendor:publish"
    ]
  }
}
