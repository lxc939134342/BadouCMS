{
  "name": "badoucms/aiagent",
  "description": "BadouCMS Agent backend assistant plugin",
  "type": "library",
  "license": "Apache-2.0",
  "require": {
    "php": ">=8.1 <8.5",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-zip": "*",
    "ext-xmlreader": "*",
    "neuron-core/neuron-ai": "4.0.0"
  },
  "extra": {
    "badoucms": {
      "shared-require": {
        "topthink/framework": "8.1.4",
        "guzzlehttp/guzzle": "^7.8.1",
        "phpoffice/phpspreadsheet": "^2.1.17"
      }
    }
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
