<!-- upgrade start -->
<style>
    .upgrade a{
        height: 24px;
        line-height: 24px;
        border-radius: 12px;
        padding: 0 12px;
        cursor: pointer;
        color:#f39c13 !important;
        background-color:rgb(253.8, 245.1, 231.4) ;
        border-color: rgb(252.6, 235.2, 207.8);
        font-size: 12px !important;
        margin:0 15px;
    }
</style>
<script>
    layui.use(['badou','toast','layer','laytpl'],function(){
        var toast=layui.toast;
        var laytpl=layui.laytpl;
        var layer=layui.layer;
        var badou=layui.badou

        $(document).on("click", ".btn-frame-upgrade", function () {
            var conflicttpl = document.getElementById('conflicttpl').innerHTML;
            badou.api.ajax({
                url: 'upgrade/upgrade',
            },function(data,res){
                layer.closeAll();
                toast.success({
                    message:res.msg,
                    onClosing:function(){
                        location.reload();
                    }
                })
                return false;
            },function(data,res){
                if(res.code==-1){
                    var conflictlist= laytpl(conflicttpl,{tagStyle:"modern"}).render({conflictlist:data.conflictFiles})
                    layer.confirm(conflictlist, {
                        title: __("Warning"),
                        area:['600px','400px'],
                        btn: [__('Force Update'), __('Cancel')],
                    }, function (index, layero) {
                        badou.api.ajax({
                            url: 'upgrade/upgrade',
                            data:{force:1}
                        },function(res){
                            layer.closeAll();
                            toast.success({
                                message:res.msg,
                                onClosing:function(){
                                    location.reload();
                                }
                            })
                            return false;
                        });
                    });
                    return false;
                }
            });
        });
    })
</script>
<!-- upgrade end -->